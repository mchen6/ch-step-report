{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "reportService": {
    "assemble": {
      "input": {
        "type": "object",
        "properties": {
          "run": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "workflow": {
                "type": "string"
              },
              "job": {
                "type": "string"
              },
              "step": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "url",
              "branch",
              "commit",
              "workflow",
              "job",
              "step"
            ],
            "additionalProperties": false
          },
          "failedJobs": {
            "title": "every failed job of the run, in GitHub's order",
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "step": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "firstError": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "step",
                "firstError"
              ],
              "additionalProperties": false
            }
          },
          "errors": {
            "title": "the few error lines, redacted",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "history": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "signature": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "window": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "new",
                      "flaky",
                      "recurring"
                    ]
                  },
                  "firstSeen": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "runId",
                      "commit",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  "lastSeen": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "runId",
                      "commit",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  "runIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "signature",
                  "count",
                  "window",
                  "verdict",
                  "firstSeen",
                  "lastSeen",
                  "runIds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "ownerHint": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "logins": {
                    "title": "GitHub logins, as ch-step-owner-hint returns them",
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "pattern": "^[^@\\s]+$"
                    }
                  },
                  "why": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "logins",
                  "why"
                ],
                "additionalProperties": false
              }
            ]
          },
          "coverage": {
            "type": "object",
            "properties": {
              "runsListed": {
                "type": "integer",
                "minimum": 0
              },
              "failedRuns": {
                "type": "integer",
                "minimum": 0
              },
              "logsFetched": {
                "type": "integer",
                "minimum": 0
              },
              "logsExpired": {
                "type": "integer",
                "minimum": 0
              },
              "logsTruncated": {
                "title": "logs the server returned shorter than the log",
                "type": "integer",
                "minimum": 0
              },
              "logsUnavailable": {
                "title": "logs that could not be read for another reason, by run and job (the job name redacted)",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "job": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "runId",
                    "job"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "cacheHits": {
                "type": "integer",
                "minimum": 0
              },
              "capHit": {
                "type": "boolean"
              },
              "historyRebuilt": {
                "title": "the cache was rebuilt: the failure signature's algorithm changed",
                "type": "boolean"
              }
            },
            "required": [
              "runsListed",
              "failedRuns",
              "logsFetched",
              "logsExpired",
              "logsTruncated",
              "logsUnavailable",
              "cacheHits",
              "capHit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "run",
          "errors",
          "history",
          "ownerHint",
          "coverage"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "summary": {
            "title": "one sentence",
            "type": "string"
          },
          "run": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "workflow": {
                "type": "string"
              },
              "job": {
                "type": "string"
              },
              "step": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "url",
              "branch",
              "commit",
              "workflow",
              "job",
              "step"
            ],
            "additionalProperties": false
          },
          "failed_jobs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "title": "every failed job of the run (the first 50), or null when not given; which ones gate the run is not known",
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "string"
                    },
                    "step": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "first_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "job",
                    "step",
                    "first_error"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          },
          "errors": {
            "title": "the few error lines, redacted",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "history": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "signature": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "window": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "new",
                      "flaky",
                      "recurring"
                    ]
                  },
                  "firstSeen": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "runId",
                      "commit",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  "lastSeen": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "runId",
                      "commit",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  "runIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "signature",
                  "count",
                  "window",
                  "verdict",
                  "firstSeen",
                  "lastSeen",
                  "runIds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "owner_hint": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "logins": {
                    "title": "GitHub logins, as ch-step-owner-hint returns them",
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "pattern": "^[^@\\s]+$"
                    }
                  },
                  "why": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "logins",
                  "why"
                ],
                "additionalProperties": false
              }
            ]
          },
          "coverage": {
            "type": "object",
            "properties": {
              "runsListed": {
                "type": "integer",
                "minimum": 0
              },
              "failedRuns": {
                "type": "integer",
                "minimum": 0
              },
              "logsFetched": {
                "type": "integer",
                "minimum": 0
              },
              "logsExpired": {
                "type": "integer",
                "minimum": 0
              },
              "logsTruncated": {
                "title": "logs the server returned shorter than the log",
                "type": "integer",
                "minimum": 0
              },
              "logsUnavailable": {
                "title": "logs that could not be read for another reason, by run and job (the job name redacted)",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "job": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "runId",
                    "job"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "cacheHits": {
                "type": "integer",
                "minimum": 0
              },
              "capHit": {
                "type": "boolean"
              },
              "historyRebuilt": {
                "title": "the cache was rebuilt: the failure signature's algorithm changed",
                "type": "boolean"
              }
            },
            "required": [
              "runsListed",
              "failedRuns",
              "logsFetched",
              "logsExpired",
              "logsTruncated",
              "logsUnavailable",
              "cacheHits",
              "capHit",
              "historyRebuilt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "summary",
          "run",
          "failed_jobs",
          "errors",
          "history",
          "owner_hint",
          "coverage"
        ],
        "additionalProperties": false
      }
    }
  },
  "fault": {
    "reportService": {
      "assemble": {
        "fault": {
          "type": "object",
          "properties": {
            "reason": {
              "title": "specific error reason",
              "type": "string"
            },
            "info": {
              "title": "detailed error info",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
